# Copy to seo/.env (git-ignored). Every key here is read-only on its service,
# except where noted. Set spend limits on paid services before the first run.

# Google Search Console — OAuth client from a Google Cloud project with the
# Search Console API enabled, and a refresh token for an account with access to
# the property. GSC_PROPERTY is exactly as Search Console shows it, e.g.
# https://vetkeep-liart.vercel.app/ or sc-domain:example.com
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
GSC_PROPERTY=

# DataForSEO. Sandbox unless DATAFORSEO_LIVE=1. 2288 = Ghana.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION=2288
# DATAFORSEO_LIVE=1

# Firecrawl — reads pages in full.
FIRECRAWL_API_KEY=

# Parallel — web search outside the site.
PARALLEL_API_KEY=

# PageSpeed Insights — optional; only raises the quota.
PAGESPEED_API_KEY=

# PostHog — conversions per landing page. A personal API key scoped to
# query:read only.
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
