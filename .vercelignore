# Vercel builds from the repository with Root Directory set to apps/web.
# Everything here is regenerated by the build or has no business leaving this
# machine.
#
# Note what is NOT excluded: apps/mobile and packages/*. The root package.json
# declares them as npm workspaces, so removing them breaks `npm install` before
# the web application is ever built. An earlier version of this file excluded
# apps/mobile and the build failed for exactly that reason.
#
# This file also protects the CLI path: `vercel deploy` walks the working tree
# and without these entries tried to upload 2.3 GB of node_modules and local
# Supabase volumes before failing on the 100 MB file limit.

node_modules
**/node_modules

.next
**/.next
**/dist
**/*.tsbuildinfo
.turbo
**/.turbo

.expo
**/.expo
apps/mobile/android
apps/mobile/ios

# Local Supabase container state.
supabase/.branches
supabase/.temp

.claude
