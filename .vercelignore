# Vercel builds from source; everything here is either regenerated by the build
# or has no business leaving this machine.
#
# Without this, `vercel deploy` from the CLI walks the whole working tree and
# tries to upload node_modules, build caches and the local Supabase volumes —
# 2.3 GB, which fails on the 100 MB file limit. Git-triggered deploys read the
# repository and are unaffected, but the CLI path should not be a trap.

node_modules
**/node_modules

.next
**/.next
**/dist
**/*.tsbuildinfo

# Local Supabase: containers, volumes and anything the local stack writes.
supabase/.branches
supabase/.temp

# Nothing here is needed to build the web application.
apps/mobile
docs
.claude
.expo
**/.expo
