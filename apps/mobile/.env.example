# Copy to .env.local and fill in from `npm run db:start`.
#
# This is the local Docker setup, for working offline or against a schema you
# are still changing. The usual default is hosted staging instead:
#   cp apps/mobile/.env.staging apps/mobile/.env.local
#
# Use this machine's LAN address, not 127.0.0.1. A phone resolves loopback to
# itself, so the app fails to reach Supabase with a bare network error that
# looks like the server is down. Find it with `ipconfig` on Windows or
# `ifconfig` elsewhere, and take the WiFi adapter's address: a machine running
# Docker or WSL also has virtual adapters on similar-looking subnets that a
# phone cannot reach.
#
# The address is usually DHCP assigned, so it changes when the network does.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Where the public health passport link points (brief §10.1). Deployed and
# answering. Pointing this at a local web server is fine for development, but a
# link generated that way only opens on this network.
EXPO_PUBLIC_PASSPORT_BASE_URL=https://vetkeep-liart.vercel.app
