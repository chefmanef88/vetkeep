{
  "name": "@vetkeep/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "//go": "Expo Go on a physical phone. --go pins the client so it cannot start in dev-build mode, which is what `dev` does. Needs the phone on the same WiFi as this machine and TCP 8081 allowed inbound.",
    "go": "expo start --go",
    "//tunnel": "Expo Go when the phone and this machine are not on the same network, or the WiFi blocks device-to-device traffic. Slower; routes the bundle through ngrok.",
    "tunnel": "expo start --go --tunnel",
    "//web": "Design preview only. Renders the screens in a browser so a layout change can be seen without an EAS build. Not a shipping target: native modules degrade or no-op here.",
    "web": "expo start --web --port 8082 --clear",
    "build": "expo export --platform android --output-dir dist/android --max-workers 2",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "2.117.3",
    "@vetkeep/contracts": "*",
    "@vetkeep/database": "*",
    "@vetkeep/domain": "*",
    "@vetkeep/observability": "*",
    "@vetkeep/sync": "*",
    "@vetkeep/validation": "*",
    "expo": "~58.0.19",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.5",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.2",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
