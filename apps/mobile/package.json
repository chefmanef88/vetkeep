{
  "name": "@vetkeep/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "//web": "Design preview only. Renders the screens in a browser so a layout change can be seen without an EAS build. Not a shipping target: native modules degrade or no-op here.",
    "web": "expo start --web --port 8082 --clear",
    "build": "expo export --platform android --output-dir dist/android --max-workers 2",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "2.110.2",
    "@vetkeep/contracts": "*",
    "@vetkeep/database": "*",
    "@vetkeep/domain": "*",
    "@vetkeep/observability": "*",
    "@vetkeep/sync": "*",
    "@vetkeep/validation": "*",
    "expo": "~57.0.9",
    "expo-application": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-file-system": "57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-picker": "^57.0.7",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-local-authentication": "~57.0.2",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.10",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "typescript": "~6.0.3"
  }
}
