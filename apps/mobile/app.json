{
  "expo": {
    "name": "VetKeep",
    "slug": "vetkeep",
    "scheme": "vetkeep",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vetkeep.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "VetKeep uses Face ID to protect locally cached veterinary records."
      }
    },
    "android": {
      "package": "com.vetkeep.mobile",
      "allowBackup": false,
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.USE_FINGERPRINT"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow VetKeep to use Face ID to protect veterinary records."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow VetKeep to use Face ID to unlock the app."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow VetKeep to take clinical photographs during a consultation.",
          "photosPermission": "Allow VetKeep to attach an existing photograph to a patient record."
        }
      ],
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc683600-8b88-4535-ae4b-8ce8deed85c7"
      }
    }
  }
}
