{
  "expo": {
    "name": "VetKeep",
    "slug": "vetkeep",
    "scheme": "vetkeep",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vetkeep.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "VetKeep uses Face ID to protect locally cached veterinary records."
      }
    },
    "android": {
      "package": "com.vetkeep.mobile",
      "allowBackup": false,
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.USE_FINGERPRINT"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#174D35"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow VetKeep to use Face ID to protect veterinary records."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow VetKeep to use Face ID to unlock the app."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow VetKeep to take clinical photographs during a consultation.",
          "photosPermission": "Allow VetKeep to attach an existing photograph to a patient record."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#174D35",
          "imageWidth": 180
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc683600-8b88-4535-ae4b-8ce8deed85c7"
      }
    }
  }
}
