NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where someone writes who cannot sign in to close their own account.
#
# Optional, and /delete-account drops that section when it is unset rather than
# printing an address nobody reads. But Google Play requires a deletion route
# for a user who has lost access, so this must be a real, monitored mailbox
# before the application is submitted.
# NEXT_PUBLIC_SUPPORT_EMAIL=
